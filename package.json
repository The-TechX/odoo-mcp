{
  "name": "odoo-mcp",
  "version": "0.1.0",
  "description": "A generic Model Context Protocol server for Odoo",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build",
    "test:integration": "vitest run test/integration/live-odoo.test.ts test/integration/mcp-e2e.test.ts",
    "test:integration:docker": "bash scripts/run-live-integration.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "5.1.0",
    "mcp-auth": "^1.0.0-beta.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "eslint": "^9.39.5",
    "jose": "^6.2.12",
    "tsx": "4.20.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
