# Odoo 19+ JSON-2 API connection
ODOO_URL=https://your-odoo.example.com
ODOO_API_KEY=replace-with-an-api-key
# Optional when the hostname uniquely identifies the database.
# ODOO_DATABASE=your-database
ODOO_TIMEOUT_MS=10000

# MCP guardrails. Writes are disabled by default.
ODOO_MCP_MODE=read-only
# Optional comma-separated exact technical model names.
# ODOO_MCP_ALLOW_MODELS=res.partner,sale.order
# ODOO_MCP_DENY_MODELS=res.users,ir.config_parameter

# MCP transport. stdio remains the local/default transport.
MCP_TRANSPORT=stdio
# For a remote/container HTTP endpoint use http and bind deliberately.
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3000
# When binding beyond localhost, restrict accepted Host headers.
# MCP_HTTP_ALLOWED_HOSTS=mcp.example.com,localhost
# HTTP authentication is Bearer by default. Use a high-entropy token (32+ chars).
# MCP_HTTP_BEARER_TOKEN=replace-with-a-long-random-token
# Explicit opt-out for already-trusted/private networks only:
# MCP_HTTP_AUTH=none
